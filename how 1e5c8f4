[32m+[m[32m│   │   ├── v1.0-test[m
[32m+[m[32m|   |   ├── v1.0-trainval[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32mFor RCBEVDet, prepare nuscenes data by running[m
[32m+[m[32m```bash[m
[32m+[m[32mpython tools/create_data_nuscenes_RC.py[m
[32m+[m[32m```[m
[32m+[m
[32m+[m
[32m+[m[32m### training[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32m./tools/dist_train.sh $config_path $gpus[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m### testing[m
[32m+[m
[32m+[m[32mtesting on validation set[m
[32m+[m
[32m+[m[32m```bash[m
[32m+[m[32m./tools/dist_test.sh $config_path $checkpoint_path $gpus --eval bbox[m
