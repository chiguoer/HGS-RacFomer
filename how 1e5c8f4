[32m+[m[32m(for A800 or A40 + cuda 12.1)[m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m```[m
[32m+[m[32mpython                       3.8.13[m
[32m+[m[32mcuda                         11.6[m
[32m+[m[32mpytorch                      1.12.1+cu116[m
